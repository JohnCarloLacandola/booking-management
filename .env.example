# Application
VITE_APP_NAME="Booking Management System"
VITE_APP_URL="http://localhost:5173"
VITE_APP_DESCRIPTION="A comprehensive booking management system for Philippines"

# Supabase Configuration (Primary Backend Option)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"  # Server-side only, never expose in client

# Alternative: Custom Backend API
# VITE_API_URL="http://localhost:3000/api"
# VITE_API_TIMEOUT="30000"

# Authentication
VITE_ENABLE_REGISTRATION="true"
VITE_ENABLE_EMAIL_VERIFICATION="true"
VITE_PASSWORD_MIN_LENGTH="8"
VITE_SESSION_TIMEOUT_MINUTES="60"

# Philippines-Specific Configuration
VITE_DEFAULT_CURRENCY="PHP"
VITE_CURRENCY_SYMBOL="₱"
VITE_TIMEZONE="Asia/Manila"
VITE_DATE_FORMAT="MM/dd/yyyy"
VITE_TIME_FORMAT="hh:mm a"
VITE_DATETIME_FORMAT="MM/dd/yyyy hh:mm a"
VITE_PHONE_CODE="+63"
VITE_COUNTRY_CODE="PH"

# Payment Methods (Philippines)
VITE_ENABLE_CASH="true"
VITE_ENABLE_GCASH="true"
VITE_ENABLE_PAYMAYA="true"
VITE_ENABLE_BANK_TRANSFER="true"
VITE_ENABLE_CHECK="true"

# Bank Options for Bank Transfer
VITE_SUPPORTED_BANKS="BDO,BPI,Metrobank,Landbank,PNB,Security Bank,UnionBank,RCBC,EastWest,Other"

# Features
VITE_ENABLE_AUDIT_LOGS="true"
VITE_ENABLE_NOTIFICATIONS="false"
VITE_ENABLE_REALTIME="true"
VITE_ENABLE_EXPORT="true"
VITE_ENABLE_DARK_MODE="true"

# File Upload
VITE_MAX_FILE_SIZE_MB="5"
VITE_ALLOWED_FILE_TYPES="image/jpeg,image/png,image/webp,application/pdf"

# Pagination
VITE_DEFAULT_PAGE_SIZE="10"
VITE_MAX_PAGE_SIZE="100"

# Development
VITE_DEV_MOCK_API="false"
VITE_DEV_SEED_DATA="false"

# Analytics (Optional)
# VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
# VITE_MIXPANEL_TOKEN="your-mixpanel-token"

# Error Tracking (Optional)
# VITE_SENTRY_DSN="https://xxx@sentry.io/xxx"